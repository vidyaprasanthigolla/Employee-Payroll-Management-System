# =====================================================================
# EMPLOYEE PAYROLL MANAGEMENT SYSTEM - CONFIGURATION
# =====================================================================

PROJECT_NAME="Employee Payroll Management System"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & JWT Token Configurations
# Generate a secure key in production via: openssl rand -hex 32
SECRET_KEY="supersecret_payroll_jwt_encryption_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Primary: MySQL 8.0+
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="mysql+pymysql://root:root@localhost:3306/payroll_db"

# Fallback: SQLite is used automatically if MySQL is unreachable or for isolated local testing
USE_SQLITE_FALLBACK=True
SQLITE_FALLBACK_URL="sqlite:///./payroll.db"

# CORS configuration (list of allowed origins separated by commas)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,*"

# Organization Metadata (Used for Payslip PDF headers)
COMPANY_NAME="Antigravity Enterprise Solutions Inc."
COMPANY_ADDRESS="100 Tech Innovation Boulevard, Silicon Valley, CA"
COMPANY_CONTACT="hr@antigravity.io | +1 (555) 019-2834"

# Document storage
UPLOAD_DIR="./uploads"
PAYSLIP_DIR="./uploads/payslips"
